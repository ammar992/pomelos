# Copy to .env.local (never commit real values). All secrets are server-only.

# Public site origin, no trailing slash (used for canonical URLs, sitemap, hreflang).
NEXT_PUBLIC_SITE_URL=https://pomelos.com.tw

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# In development, Cloudflare's always-pass TEST keys are used automatically when unset.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames tokens must be issued for (production hardening).
TURNSTILE_ALLOWED_HOSTNAMES=pomelos.com.tw,www.pomelos.com.tw

# Email delivery via Resend (https://resend.com). Plain-text emails only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=Business@pomelos.com.tw
CONTACT_FROM_EMAIL="Pomelos Website <noreply@pomelos.com.tw>"

# Set to "true" ONLY when the app is served exclusively through Cloudflare,
# so the cf-connecting-ip header can be trusted for rate limiting.
TRUST_CLOUDFLARE_IP=false
